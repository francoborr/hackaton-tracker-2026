# PIN compartido del jurado (sin esto las mutaciones quedan abiertas solo en desarrollo
# local; en producción se rechazan con 401)
JURY_PIN=
# Inyectadas por la integración Upstash Redis de Vercel (prefijo KV_*)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternativa si la base se crea a mano en Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Webhook del canal de Slack donde se avisa cada carta jugada (opcional: sin esto no
# se manda nada). Se crea en https://api.slack.com/apps → Incoming Webhooks.
SLACK_WEBHOOK_URL=
